#N canvas 60 60 900 402 12;
#X text 20 10 PHYSICAL MODELS INSTRUMENT;
#X text 20 34 Pure Data / plugdata version. Needs the csound7~ external: see README.md in the pd folder of the repository;
#X msg 20 58 \; pd dsp 1;
#X msg 110 58 \; pd dsp 0;
#X text 200 58 audio on / off;
#X text 20 108 MIDI keyboard: play a connected MIDI keyboard \, or click the two boxes to test;
#X obj 20 132 notein;
#X obj 20 162 pack 0 0;
#X msg 20 192 midi 144 \$1 \$2;
#X msg 220 162 midi 144 60 100;
#X msg 340 162 midi 144 60 0;
#X text 220 142 note on / note off (middle C);
#X obj 20 262 csound7~ PHYSICAL_MODELS_INSTRUMENT.csd;
#X text 280 262 control messages go to the LEFTMOST inlet;
#X obj 20 312 dac~ 1 2;
#X connect 6 0 7 0;
#X connect 6 1 7 1;
#X connect 7 0 8 0;
#X connect 8 0 12 0;
#X connect 9 0 12 0;
#X connect 10 0 12 0;
#X connect 12 0 14 0;
#X connect 12 1 14 1;
