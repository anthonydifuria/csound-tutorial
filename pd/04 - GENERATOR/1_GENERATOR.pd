#N canvas 60 60 900 320 12;
#X text 20 10 1_GENERATOR;
#X text 20 34 Pure Data / plugdata version. Needs the csound7~ external: see README.md in the pd folder of the repository;
#X msg 20 58 \; pd dsp 1;
#X msg 110 58 \; pd dsp 0;
#X text 200 58 audio on / off;
#X text 20 98 DUR;
#X obj 20 116 hsl 128 15 0.01 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 116 6 0 0 0 - - - 0;
#X msg 220 116 dur \$1;
#X text 320 98 DEN;
#X obj 320 116 hsl 128 15 1 20 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 116 6 0 0 0 - - - 0;
#X msg 520 116 den \$1;
#X obj 420 38 loadbang;
#X msg 420 66 0.01;
#X msg 470 66 1;
#X obj 20 180 csound7~ 1_GENERATOR.csd;
#X text 280 180 control messages go to the LEFTMOST inlet;
#X obj 20 230 dac~ 1 2;
