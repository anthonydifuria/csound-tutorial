#N canvas 60 60 900 740 12;
#X text 20 10 2 ADDITIVE SYNTHESIS with GEN functions;
#X text 20 34 Pure Data / plugdata version. Needs the csound7~ external: see README.md in the pd folder of the repository;
#X msg 20 58 \; pd dsp 1;
#X msg 110 58 \; pd dsp 0;
#X text 200 58 audio on / off;
#X text 20 98 ATT;
#X obj 20 116 hsl 128 15 0.001 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 116 6 0 0 0 - - - 0;
#X msg 220 116 att \$1;
#X text 320 98 DEC;
#X obj 320 116 hsl 128 15 0.001 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 116 6 0 0 0 - - - 0;
#X msg 520 116 dec \$1;
#X text 20 150 SUS;
#X obj 20 168 hsl 128 15 0 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 168 6 0 0 0 - - - 0;
#X msg 220 168 sus \$1;
#X text 320 150 REL;
#X obj 320 168 hsl 128 15 0.001 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 168 6 0 0 0 - - - 0;
#X msg 520 168 rel \$1;
