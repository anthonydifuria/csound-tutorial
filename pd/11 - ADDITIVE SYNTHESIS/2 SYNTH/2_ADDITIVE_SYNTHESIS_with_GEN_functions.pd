#X obj 20 220 hsl 128 15 0 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 220 6 0 0 0 - - - 0;
#X msg 220 220 out \$1;
