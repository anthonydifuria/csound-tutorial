#X obj 320 202 bng 18 250 50 0 empty empty empty 20 9 0 10 #fcfcfc #000000 #000000;
#X obj 320 224 t b b;
#X msg 360 224 trigger 1;
#X obj 430 224 del 60;
#X msg 470 224 trigger 0;
#X text 20 254 onde: 1=SINE / 2=SQUARE / 3=SAW / 4=TRIANGLE;
#X obj 20 276 hradio 15 1 0 4 empty empty empty 0 -8 0 10 #fcfcfc #000000 #000000 0;
#X obj 88 276 + 1;
#X msg 130 276 onde \$1;
#X text 20 316 MIDI keyboard: play a connected MIDI keyboard \, or click the two boxes to test;
#X obj 20 340 notein;
#X obj 20 370 pack 0 0;
#X msg 20 400 midi 144 \$1 \$2;
#X msg 220 370 midi 144 60 100;
#X msg 340 370 midi 144 60 0;
#X text 220 350 note on / note off (middle C);
#N canvas 0 0 450 300 (subpatch) 0;
#X array \$0-scope 512 float 2;
#X coords 0 1 511 -1 240 100 1 0 0;
#X restore 20 470 graph;
#X text 20 450 output waveform (left channel);
