#X floatatom 155 250 6 0 0 0 - - - 0;
#X msg 220 250 trans \$1;
#X msg 20 294 event i 1 0 -1;
#X msg 180 294 event i -1 0 0;
#X text 50 276 start (after choosing the file);
#X text 210 276 stop;
