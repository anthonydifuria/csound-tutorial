#N canvas 60 60 900 558 12;
#X text 20 10 4 Synth with 1 Oscillator AMP CONTROL and ENV;
#X text 20 34 Pure Data / plugdata version. Needs the csound7~ external: see README.md in the pd folder of the repository;
#X msg 20 58 \; pd dsp 1;
#X msg 110 58 \; pd dsp 0;
#X text 200 58 audio on / off;
#X text 20 98 Amplitude;
#X obj 20 116 hsl 128 15 0 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 116 6 0 0 0 - - - 0;
#X msg 220 116 amp \$1;
#X text 320 98 ATT;
#X obj 320 116 hsl 128 15 0.001 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 116 6 0 0 0 - - - 0;
#X msg 520 116 att \$1;
#X text 20 150 DEC;
#X obj 20 168 hsl 128 15 0.001 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 168 6 0 0 0 - - - 0;
#X msg 220 168 dec \$1;
#X text 320 150 SUS;
#X obj 320 168 hsl 128 15 0 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 168 6 0 0 0 - - - 0;
#X msg 520 168 sus \$1;
#X text 20 202 REL;
#X obj 20 220 hsl 128 15 0.001 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 220 6 0 0 0 - - - 0;
#X msg 220 220 rel \$1;
#X text 20 264 MIDI keyboard: play a connected MIDI keyboard \, or click the two boxes to test;
#X obj 20 288 notein;
#X obj 20 318 pack 0 0;
#X msg 20 348 midi 144 \$1 \$2;
#X msg 220 318 midi 144 60 100;
#X msg 340 318 midi 144 60 0;
#X text 220 298 note on / note off (middle C);
