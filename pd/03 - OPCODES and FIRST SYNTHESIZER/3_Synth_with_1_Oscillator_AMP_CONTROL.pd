#N canvas 60 60 900 454 12;
#X text 20 10 3 Synth with 1 Oscillator AMP CONTROL;
#X text 20 34 Pure Data / plugdata version. Needs the csound7~ external: see README.md in the pd folder of the repository;
#X msg 20 58 \; pd dsp 1;
#X msg 110 58 \; pd dsp 0;
#X text 200 58 audio on / off;
#X text 20 98 Amplitude;
#X obj 20 116 hsl 128 15 0 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 116 6 0 0 0 - - - 0;
#X msg 220 116 amp \$1;
#X text 20 160 MIDI keyboard: play a connected MIDI keyboard \, or click the two boxes to test;
#X obj 20 184 notein;
#X obj 20 214 pack 0 0;
#X msg 20 244 midi 144 \$1 \$2;
#X msg 220 214 midi 144 60 100;
#X msg 340 214 midi 144 60 0;
#X text 220 194 note on / note off (middle C);
#X obj 420 38 loadbang;
#X msg 420 66 0.5;
#X obj 20 314 csound7~ 3_Synth_with_1_Oscillator_AMP_CONTROL.csd;
#X text 280 314 control messages go to the LEFTMOST inlet;
#X obj 20 364 dac~ 1 2;
#X connect 6 0 7 0;
#X connect 6 0 8 0;
#X connect 10 0 11 0;
#X connect 10 1 11 1;
#X connect 11 0 12 0;
#X connect 16 0 17 0;
#X connect 17 0 6 0;
#X connect 8 0 18 0;
#X connect 12 0 18 0;
#X connect 13 0 18 0;
#X connect 14 0 18 0;
#X connect 18 0 20 0;
#X connect 18 1 20 1;
