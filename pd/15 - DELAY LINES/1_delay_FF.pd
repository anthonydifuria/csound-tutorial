#N canvas 60 60 900 320 12;
#X text 20 10 1 delay FF;
#X text 20 34 Pure Data / plugdata version. Needs the csound7~ external: see README.md in the pd folder of the repository;
#X msg 20 58 \; pd dsp 1;
#X msg 110 58 \; pd dsp 0;
#X text 200 58 audio on / off;
#X text 20 98 Delay Time;
#X obj 20 116 hsl 128 15 0 2000 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 116 6 0 0 0 - - - 0;
#X msg 220 116 time \$1;
#X text 320 98 Dry/Wet;
#X obj 320 116 hsl 128 15 0 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 116 6 0 0 0 - - - 0;
#X msg 520 116 drywet \$1;
#X obj 420 38 loadbang;
#X msg 420 66 500;
#X msg 470 66 0.5;
#X obj 20 180 csound7~ 1_delay_FF.csd;
#X obj 420 140 adc~ 1 2;
#X text 490 140 live input (use headphones);
#X text 280 180 control messages go to the LEFTMOST inlet;
