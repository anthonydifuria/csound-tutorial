#X obj 320 380 t b b;
#X msg 360 380 trigger 1;
#X obj 430 380 del 60;
#X msg 470 380 trigger 0;
#X text 20 410 onde: 1=SERIES / 2=SQUARE / 3=SAW / 4=TRIANGLE;
