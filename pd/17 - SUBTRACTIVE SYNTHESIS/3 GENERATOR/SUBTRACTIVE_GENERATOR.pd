#N canvas 60 60 900 606 12;
#X text 20 10 SUBTRACTIVE_GENERATOR;
#X text 20 34 Pure Data / plugdata version. Needs the csound7~ external: see README.md in the pd folder of the repository;
#X msg 20 58 \; pd dsp 1;
#X msg 110 58 \; pd dsp 0;
#X text 200 58 audio on / off;
#X text 20 98 DUR;
#X obj 20 116 hsl 128 15 0.01 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 116 6 0 0 0 - - - 0;
#X msg 220 116 dur \$1;
#X text 320 98 DEN;
#X obj 320 116 hsl 128 15 1 100 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 116 6 0 0 0 - - - 0;
#X msg 520 116 den \$1;
#X text 20 150 FUND FREQ;
#X obj 20 168 hsl 128 15 20 1000 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 168 6 0 0 0 - - - 0;
#X msg 220 168 ffond \$1;
#X text 320 150 SPREAD FREQ;
#X obj 320 168 hsl 128 15 0 400 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 168 6 0 0 0 - - - 0;
#X msg 520 168 spreadfreq \$1;
#X text 20 202 HARMONICS;
#X obj 20 220 hsl 128 15 1 10 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 220 6 0 0 0 - - - 0;
#X msg 220 220 harm \$1;
#X text 320 202 SPREAD PAN;
#X obj 320 220 hsl 128 15 0 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 220 6 0 0 0 - - - 0;
#X msg 520 220 spreadpan \$1;
#X text 20 254 WIDTH BAND;
#X obj 20 272 hsl 128 15 2 400 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 155 272 6 0 0 0 - - - 0;
#X msg 220 272 WidthBand \$1;
#X text 320 254 OUTPUT;
#X obj 320 272 hsl 128 15 0 1 0 0 empty empty empty -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 455 272 6 0 0 0 - - - 0;
#X msg 520 272 out \$1;
#N canvas 0 0 450 300 (subpatch) 0;
#X array \$0-scope 512 float 2;
#X coords 0 1 511 -1 240 100 1 0 0;
#X restore 20 336 graph;
#X text 20 316 output waveform (left channel);
#X obj 280 336 tabwrite~ \$0-scope;
