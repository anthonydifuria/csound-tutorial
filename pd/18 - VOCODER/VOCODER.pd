#N canvas 60 60 900 576 12;
#X text 20 10 VOCODER;
#X text 20 34 Pure Data / plugdata version. Needs the csound7~ external: see README.md in the pd folder of the repository;
#X msg 20 58 \; pd dsp 1;
#X msg 110 58 \; pd dsp 0;
#X text 200 58 audio on / off;
#X text 20 98 This lesson plays a sound file: 1) click the bang and choose a file from the audio folder of the repository \, 2) click start.;
#X obj 20 120 bng 18 250 50 0 empty empty empty 20 9 0 10 #fcfcfc #000000 #000000;
#X text 50 122 open file 1: PAROLAI.WAV;
#X obj 20 146 openpanel;
#X msg 20 170 diskinfile audiofile1 \$1;
#X text 20 242 MIDI keyboard: play a connected MIDI keyboard \, or click the two boxes to test;
#X obj 20 266 notein;
#X obj 20 296 pack 0 0;
#X msg 20 326 midi 144 \$1 \$2;
#X msg 220 296 midi 144 60 100;
#X msg 340 296 midi 144 60 0;
#X text 220 276 note on / note off (middle C);
#X msg 20 376 event i 50 0 -1;
#X msg 180 376 event i -50 0 0;
#X text 50 358 start (after choosing the file);
#X text 210 358 stop;
#X obj 20 436 csound7~ VOCODER.csd;
#X text 280 436 control messages go to the LEFTMOST inlet;
#X obj 20 486 dac~ 1 2;
#X connect 6 0 8 0;
#X connect 8 0 9 0;
#X connect 11 0 12 0;
#X connect 11 1 12 1;
#X connect 12 0 13 0;
#X connect 9 0 21 0;
#X connect 13 0 21 0;
#X connect 14 0 21 0;
#X connect 15 0 21 0;
#X connect 17 0 21 0;
#X connect 18 0 21 0;
#X connect 21 0 23 0;
#X connect 21 1 23 1;
